# 服务端口
PORT=3001
# 站点对外地址（用于生成分享链接 / 文档说明，可选）
PUBLIC_URL=http://localhost:3001

# 浏览器来源：
#   tinyfish = 使用 TinyFish 云端浏览器（需要用户在前端填 API Key）
#   local    = 连接本机 Chromium（用于本地开发/演示，无需 TinyFish Key）
BROWSER_MODE=tinyfish

# local 模式下的 Chromium 路径（可留空自动探测）
# CHROMIUM_PATH=/usr/bin/chromium
# 本地 Chromium 远程调试端口
LOCAL_CDP_PORT=9222

# API Key 加密密钥（部署到生产时务必改成随机长字符串）
ENCRYPTION_KEY=please-change-this-to-a-random-secret

# 数据存储文件（API Key / 历史 / Cookie / 用量）
DATA_FILE=./data/store.json
